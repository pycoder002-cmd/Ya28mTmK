<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardApp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardBackgroundColor="@color/colorAppDetailsBackground"
    card_view:cardCornerRadius="8dp"
    card_view:cardElevation="0dp"
    card_view:cardUseCompatPadding="false">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/icon_container"
            android:background="@color/colorAppDetailsBackgroundDark"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/category_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/agilidad_mental"
                android:scaleType="fitCenter"
                android:contentDescription="TODO"/>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/md_bluegrey900"
            android:layout_gravity="center_vertical"
            android:id="@+id/category_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="8dp"
            android:text=""
            android:maxLines="2"/>
    </LinearLayout>
</android.support.v7.widget.CardView>
