<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/md_bluegrey900"
            android:layout_gravity="center_vertical"
            android:id="@+id/snapTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Snap center"/>
    </LinearLayout>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"/>
    <RelativeLayout
        android:id="@+id/more_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="2dp">
        <View
            android:background="@color/colorAppDetailsBackgroundDark"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0.1dp"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:id="@+id/btn_more"
            android:background="@drawable/bg_btn_more"
            android:paddingRight="12dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/ic_plus"
                android:padding="4dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@mipmap/ic_plus"
                android:contentDescription="TODO"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
