<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_text_expand_animation_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/material_bluegrey600"
            android:id="@+id/tv_expand_text_view_animation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"/>
        <View
            android:id="@+id/gradient_transparent"
            android:background="@drawable/gradient_more_transparent"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="14sp"
            android:layout_alignBottom="@+id/tv_expand_text_view_animation"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_expand_text_view_animation_toggle_layout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/btn_more"
            android:background="@drawable/bg_btn_more"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/iv_expand_text_view_animation_toggle"
                android:padding="4dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="TODO"/>
        </RelativeLayout>
        <TextView
            android:textColor="@color/colorPrimary"
            android:id="@+id/tv_expand_text_view_animation_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"/>
        <View
            android:background="@color/colorAppDetailsBackgroundDark"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0.1dp"
            android:layout_toLeftOf="@+id/btn_more"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</LinearLayout>
