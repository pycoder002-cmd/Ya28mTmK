<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:background="@color/colorSecundary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="48dp"
        android:layout_marginRight="16dp">
        <android.support.design.widget.TextInputLayout
            android:theme="@style/EditTextHint"
            android:id="@+id/til_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:errorEnabled="false"
            app:errorTextAppearance="@style/error_appearance"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/colorTextInputDark">
            <EditText
                android:textSize="14sp"
                android:textColor="@color/md_white"
                android:id="@+id/etProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_first_name"
                android:drawableTint="@color/colorTextInputDark"/>
        </android.support.design.widget.TextInputLayout>
        <android.support.design.widget.TextInputLayout
            android:theme="@style/EditTextHint"
            android:id="@+id/til_apellidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:errorEnabled="false"
            app:errorTextAppearance="@style/error_appearance"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/colorTextInputDark">
            <EditText
                android:textSize="14sp"
                android:textColor="@color/md_white"
                android:id="@+id/etProfileLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_last_name"
                android:drawableTint="@color/colorTextInputDark"/>
        </android.support.design.widget.TextInputLayout>
        <Button
            android:textSize="14sp"
            android:textColor="@color/md_white"
            android:id="@+id/btnSaveProfile"
            android:background="@drawable/check_ripple"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cardview_compat_inset_shadow"
            android:text="@string/guardar_cambios"/>
        <android.support.design.widget.TextInputLayout
            android:theme="@style/EditTextHint"
            android:id="@+id/til_password_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:errorEnabled="false"
            app:errorTextAppearance="@style/error_appearance"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/colorTextInputDark">
            <EditText
                android:textSize="14sp"
                android:textColor="@color/md_white"
                android:id="@+id/etProfilePasswordOld"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password_old"
                android:inputType="textPassword"
                android:drawableTint="@color/colorTextInputDark"/>
        </android.support.design.widget.TextInputLayout>
        <android.support.design.widget.TextInputLayout
            android:theme="@style/EditTextHint"
            android:id="@+id/til_password_repeat1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:errorEnabled="false"
            app:errorTextAppearance="@style/error_appearance"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/colorTextInputDark">
            <EditText
                android:textSize="14sp"
                android:textColor="@color/md_white"
                android:id="@+id/etProfilePasswordNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password_new"
                android:inputType="textPassword"
                android:drawableTint="@color/colorTextInputDark"/>
        </android.support.design.widget.TextInputLayout>
        <android.support.design.widget.TextInputLayout
            android:theme="@style/EditTextHint"
            android:id="@+id/til_password_repeat2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:errorEnabled="false"
            app:errorTextAppearance="@style/error_appearance"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/colorTextInputDark">
            <EditText
                android:textSize="14sp"
                android:textColor="@color/md_white"
                android:id="@+id/etProfilePasswordNewAgain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_repeat_password_new"
                android:inputType="textPassword"
                android:drawableTint="@color/colorTextInputDark"/>
        </android.support.design.widget.TextInputLayout>
        <Button
            android:textSize="14sp"
            android:textColor="@color/md_white"
            android:id="@+id/btnSavePaswd"
            android:background="@drawable/check_ripple"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cardview_compat_inset_shadow"
            android:text="@string/change_pass"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/md_white"
            android:id="@+id/btnCloseSesion"
            android:background="@drawable/action_red_btn_ripple"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/cerrar_sesi_n"/>
    </LinearLayout>
</RelativeLayout>
